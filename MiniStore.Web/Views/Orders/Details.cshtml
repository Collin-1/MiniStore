@model MiniStore.Application.ViewModels.OrderSummaryVm

<h2>Order #@Model.Id</h2>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Placed</dt>
            <dd class="col-sm-9">@Model.CreatedUtc.ToLocalTime().ToString("f")</dd>
            <dt class="col-sm-3">Total</dt>
            <dd class="col-sm-9">@Model.Total.ToString("C")</dd>
        </dl>
    </div>
</div>

<p class="mt-3">
    <a class="btn btn-primary" asp-action="My">Back to My Orders</a>
    <a class="btn btn-outline-secondary" asp-controller="Catalog" asp-action="Index">Continue Shopping</a>
</p>
