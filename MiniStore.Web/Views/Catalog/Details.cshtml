@model MiniStore.Application.ViewModels.ProductDetailsVm

<h2>@Model.Name</h2>

<p>@Model.Description</p>
<p><strong>@Model.Price.ToString("C")</strong></p>

<a class="btn btn-secondary" asp-action="Index">Back</a>

<form asp-controller="Orders" asp-action="Checkout" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ProductId" value="@Model.Id" />
    <label>Qty</label>
    <input type="number" name="Quantity" value="1" min="1" class="form-control" style="max-width:120px;" />
    <button class="btn btn-success mt-2">Checkout</button>
</form>
